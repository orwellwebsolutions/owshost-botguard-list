{
  "note": "OWS Bot Guard central list. Each list replaces the matching line in the sites' .htaccess block. Edit, commit, push - the GitHub workflow checks it and publishes it; sites pick it up within ~12 hours.",
  "dot_paths": [
    "claude", "codex", "config", "env", "git", "svn", "hg", "aws", "ssh", "docker",
    "vscode", "idea", "DS_Store", "npmrc", "composer",
    "dockercfg", "dockerenv", "ftpconfig", "remote-sync", "axiom", "tugboat"
  ],
  "json_files": [
    "auth", "credentials", "secret", "secrets", "deployment-config",
    "google-credentials", "gcp-credentials", "gcp-key", "firebase-credentials", "firebase-admin", "service-account", "sa"
  ],
  "probe_dirs": [
    "phpmyadmin", "_phpmyadmin", "phppgadmin", "adminer", "administrator",
    "nagiosxi", "nagiosfusion", "nagioslogserver", "nagiosna", "solr", "zipkin", "mifs",
    "LogonPoint", "vpns", "citrix", "CitrixAccess", "XenApp1", "XenApp2", "DesktopWeb", "zimbraAdmin",
    "sitecore", "bitrix", "pandora_console", "opennms", "webmin", "monitorix-cgi", "adfs", "virtualems",
    "iPages", "fpui", "vsapres", "sslmgr", "apache-default", "pagespeed_admin", "_profiler", "_all_dbs",
    "typo3", "concrete5", "webalizer", "webvisu", "autodiscover"
  ],
  "probe_exts": [
    "action", "do", "zul", "xsi", "vm", "mwsl", "jspx", "jsf"
  ],
  "user_agents": [
    "Bytespider", "PetalBot", "MJ12bot", "DotBot", "BLEXBot", "DataForSeoBot", "serpstatbot",
    "zgrab", "masscan", "Nuclei", "sqlmap", "nikto", "WPScan"
  ]
}
